{
  "id": "minecraft-server-management",
  "name": "minecraft-server-management",
  "version": "1.0.1",
  "description": "Minecraft Server Management",
  "main": "frontend/dist/index.html",
  "entrypoint": "frontend/dist/index.html",
  "runInBackground": true,
  "backend": "index.ts",
  "requestedPermissions": {
    "allowRead": true,
    "allowWrite": true,
    "allowNet": true,
    "allowRun": true,
    "allowDatabase": true,
    "collections": [
      "nodes",
      "servers",
      "audit_logs"
    ],
    "allowRunCommands": [
      "ping",
      "sh",
      "ip",
      "hostname",
      "java",
      "docker",
      "screen",
      "systemctl"
    ]
  }
}