SSL_KEY_PATH=key.pem
SSL_CERT_PATH=cert.pem

# Network Scanner Configuration
# If running in Docker bridge mode, the scanner will default to the Docker subnet (172.x.x.x).
# To scan your actual local network, either use network_mode: 'host' in Docker,
# or define the target subnet manually here using CIDR notation.
# SCAN_CIDR=192.168.1.0/24

# Relay Server Configuration
RELAY_TOKEN=your_jwt_token_here
RELAY_HOST=localhost
RELAY_PORT=4536
RELAY_SSL=true
REJECT_UNAUTHORIZED=false